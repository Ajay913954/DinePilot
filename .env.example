# ==========================================
# DINEPILOT ENVIRONMENT CONFIGURATION
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinepilot?schema=public"

# Session & Authentication Secret Key
# Used for encrypting session tokens and cookies. Must be a strong secret string in production.
SESSION_SECRET="dinepilot_super_secret_session_key_change_in_production_2026"

# Node Environment
# Options: development, production, test
NODE_ENV="development"

# Server Port Configuration
PORT=5000

# Frontend Web Application URL (used for CORS and redirect configurations)
APP_URL="http://localhost:5173"

# Backend API Base URL
API_URL="http://localhost:5000"
